	(text "SHEET 03 — BIAS RAILS"
		(exclude_from_sim no)
		(at 25.4 12.7 0)
		(effects (font (size 3.0 3.0) bold) (justify left bottom))
		(uuid "30000000-0000-0000-0000-000000001000")
	)

	(text "Place here:\n  • U4: AP2112K-3.3TRG1 (or XC6206P332MR) — 3.3 V / 600 mA LDO\n        IN → +5V | OUT → +3V3 | EN tied to +5V via 100 kΩ\n        Decoupling: 1 µF X5R on IN, 1 µF X5R on OUT\n  • U5: RT9013-10GB (or XC6206P102MR) — 1.0 V / 500 mA LDO\n        IN → +5V | OUT → +1V0 | EN tied to +5V via 100 kΩ\n        Decoupling: 1 µF X5R on IN, 1 µF X5R on OUT\n\n⚠️  Place PWR_FLAG on +3V3 and +1V0 here — exactly one per net.\n    Without PWR_FLAG, KiCad ERC reports missing power driver errors.\n\nPower budget (from design-spec.md §2.2):\n  RTL8153B I/O ring  (+3V3): ~200 mA typical\n  RTL8153B core      (+1V0): ~300 mA typical\n  Both LDOs are fed from the isolated 5 V / 2 A secondary rail (Sheet 02)."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "30000000-0000-0000-0000-000000001001")
	)

	(text "← +5V / GND from Sheet 02 (isolated secondary rail)"
