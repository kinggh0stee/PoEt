(version 1)

# PoEt — Custom DRC Rules
# KiCad 8 constraint expression language
# Run: PCB Editor → Inspect → Design Rules Checker

# ─── Reinforced-insulation barrier (CSA C22.2 No. 62368-1) ────────────────────
# The PoE primary side (ES2/PS2, up to 57 V DC) is operator-accessible through
# the USB-C port and enclosure, so the barrier between POE_PRIMARY nets and the
# USB secondary must satisfy *reinforced* insulation per 62368-1 §5.4.
#
# Per Table 16 (clearance, OVC I, 330 V transient): ≥ 0.5 mm
# Per Table 17 (creepage, 57 V working, PD2, material group IIIa): ≥ 1.7 mm
# Per IEEE 802.3-2022 §33.4.1 (hi-pot withstand): 1500 V rms, 1 min
#
# We enforce 4.0 mm — well above the 62368-1 reinforced minimum, allowing
# headroom for OVC II re-rating (1500 V transient → 1.5 mm) and providing the
# physical separation needed for the 3000 V rms routine hi-pot test in
# docs/BRING-UP.md Stage 7. See docs/CSA-COMPLIANCE.md §3 for the full mapping.
#
# GND_POE, V_POE+, V_SW, and the optocoupler/TL431 primary-side pins are all
# in the POE_PRIMARY netclass.

(rule "iso_barrier_clearance_reinforced"
   (severity error)
   (constraint clearance (min 4.0mm))
   (condition "A.NetClass == 'POE_PRIMARY' && B.NetClass != 'POE_PRIMARY'")
)

(rule "iso_barrier_clearance_reinforced_reverse"
   (severity error)
   (constraint clearance (min 4.0mm))
   (condition "A.NetClass != 'POE_PRIMARY' && B.NetClass == 'POE_PRIMARY'")
)

# Hole-to-copper across the barrier: any plated hole on one side must not bring
# copper within 4 mm of the other side via the annular ring. Catches accidental
# vias inside the isolation slot.

(rule "iso_barrier_hole_clearance"
   (severity error)
   (constraint hole_clearance (min 4.0mm))
   (condition "A.NetClass == 'POE_PRIMARY' && B.NetClass != 'POE_PRIMARY'")
)

# Silkscreen on F.Mask in the slot region is acceptable, but tracks crossing
# the slot are not — catch any stray segment on inner layers.

(rule "iso_barrier_no_inner_track_cross"
   (severity error)
   (constraint clearance (min 4.0mm))
   (condition "(A.NetClass == 'POE_PRIMARY' && B.NetClass != 'POE_PRIMARY') && (A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu' || B.Layer == 'In1.Cu' || B.Layer == 'In2.Cu')")
)

# ─── USB 3.2 Gen 1 SuperSpeed differential pair ────────────────────────────────
# Target: 90 Ω differential impedance on JLCPCB JLC04161H-7628 stackup
# F.Cu over solid In1.Cu GND plane: 0.15 mm trace, 0.13 mm gap

(rule "USB3_SS_track_width"
   (constraint track_width (min 0.13mm) (max 0.18mm))
   (condition "A.NetClass == 'USB3_SS'")
)

(rule "USB3_SS_diff_pair_gap"
   (constraint differential_pair_gap (min 0.11mm) (max 0.16mm))
   (condition "A.NetClass == 'USB3_SS'")
)

(rule "USB3_SS_via_count"
   (constraint via_count (max 2))
   (condition "A.NetClass == 'USB3_SS'")
)

(rule "USB3_SS_length_match"
   (constraint skew (max 0.1mm))
   (condition "A.NetClass == 'USB3_SS' && B.NetClass == 'USB3_SS'")
)

# ─── Ethernet MDI differential pairs ──────────────────────────────────────────
# Target: 100 Ω differential impedance
# F.Cu over In1.Cu GND plane: 0.25 mm trace, 0.20 mm gap

(rule "MDI_track_width"
   (constraint track_width (min 0.22mm) (max 0.28mm))
   (condition "A.NetClass == 'ETHERNET_MDI'")
)

(rule "MDI_diff_pair_gap"
   (constraint differential_pair_gap (min 0.17mm) (max 0.23mm))
   (condition "A.NetClass == 'ETHERNET_MDI'")
)

(rule "MDI_intra_pair_length_match"
   (constraint skew (max 0.5mm))
   (condition "A.NetClass == 'ETHERNET_MDI' && B.NetClass == 'ETHERNET_MDI'")
)

# ─── PoE primary power traces ──────────────────────────────────────────────────
# Primary side carries up to 350 mA DC + flyback switching transients.
# Minimum 0.5 mm track width for current handling; wider preferred.

(rule "POE_PRIMARY_track_width"
   (constraint track_width (min 0.5mm))
   (condition "A.NetClass == 'POE_PRIMARY'")
)

# ─── 5 V secondary power traces ────────────────────────────────────────────────
# Secondary rail delivers up to 2 A to VBUS. 0.4 mm minimum.

(rule "POWER_5V_track_width"
   (constraint track_width (min 0.4mm))
   (condition "A.NetClass == 'POWER_5V'")
)

# ─── Edge clearance ────────────────────────────────────────────────────────────
# Keep all copper at least 0.3 mm from board edge to prevent delamination
# and exposure during depanelization.

(rule "edge_clearance"
   (constraint edge_clearance (min 0.3mm))
)

# ─── Courtyard clearance ───────────────────────────────────────────────────────

(rule "courtyard_clearance"
   (constraint courtyard_clearance (min 0.1mm))
)

# ─── Minimum via drill ─────────────────────────────────────────────────────────
# JLCPCB standard: 0.2 mm drill (0.45 mm annular ring).
# Microvia (laser) not used in this design.

(rule "min_via_drill"
   (constraint hole_size (min 0.2mm))
)
