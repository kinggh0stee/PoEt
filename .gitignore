# KiCad
*-backups/
*.bak
*-cache.lib
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
_autosave-*
.kicad_backup/
~*
*.lck

# Generated outputs (regenerate from sources)
fabrication/gerbers/
fabrication/*.zip
fabrication/*.drl
fabrication/*-pos.csv
fabrication/*-bom.csv

# EEPROM binary — generated by eeprom-encoder.py, not hand-edited
firmware/*.bin
# Golden test fixture is checked in to detect format drift
!firmware/eeprom-default.golden.bin

# Python
__pycache__/
*.pyc
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Editor
.vscode/
.idea/
*.swp
.DS_Store
